{
  "name": "placement-prep-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for the Placement Prep app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/logic.test.js && node test/code.routes.test.js && node test/features.test.js && node test/chat.test.js && node test/workflows.test.js",
    "build:debug": "node scripts/buildDebug.js",
    "build:problems": "node scripts/buildProblems.js",
    "judge:selftest": "node scripts/judgeSelfTest.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.9.0",
    "multer": "^2.0.0",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}